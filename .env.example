# Configuración de la API de Mr. Bot
# Copia este archivo a .env y completa con tus credenciales

# URL base de la API (no modificar a menos que uses otra instancia)
URL=https://api-bots.mrbot.com.ar

# Tu email registrado en el sistema
MAIL=tu_email@ejemplo.com

# Tu API Key (solicítala en api-bots.mrbot.com.ar)
API_KEY=tu_api_key_aqui

# Timeouts de requests (segundos, opcional)
TIMEOUT_POST=1200
TIMEOUT_GET=600

# ============================================================
# Webservices (Token/Sign automático + acceso web)
# - Domicilio Fiscal Electrónico (DFE): veconsumerws
# - Facturación electrónica: wsfe
# ============================================================

# Testing/homologación por defecto para generación de token/sign (true/false)
WSAA_TESTING=true

# Servicio WSAA por defecto para Webservices
# veconsumerws = Domicilio Fiscal Electrónico (DFE)
# wsfe         = Facturación electrónica
WSAA_SERVICE=veconsumerws

# API de certificados (se utiliza para obtener token/sign)
CERT_API_URL=https://api-certificados.mrbot.com.ar/
CERT_API_TIMEOUT=60
CERT_API_EMAIL=
CERT_API_KEY=
CERT_API_CN=mrbot
# Opcional: CUIT representante por defecto para token/sign (si difiere del representado)
CERT_API_CUIT_REPRESENTANTE=

# Material criptográfico AFIP/ARCA para obtener token/sign automáticamente
# Certificado + clave privada (formato PEM/CRT/KEY)
AFIP_CERT_PATH=
AFIP_KEY_PATH=

######
# omitir en .env del ejecutable
######

# Número máximo de workers concurrentes para llamadas a la API (opcional, default: 1)
MAX_WORKERS_MRBOT_API=1

# ============================================================
# Variables para tests de integración (tests/test_descarga_nuevos_modulos.py)
# Solo necesarias si ejecutas los tests de descarga de módulos
# ============================================================

# Credenciales set 1 (para Mis Retenciones y Declaración en Línea)
TEST_CUIT_REP_1=
TEST_CLAVE_REP_1=
TEST_CUIT_REPRESENTADO_1=
TEST_DENOMINACION_1=

# Credenciales set 2 (para SIFERE)
TEST_CUIT_REP_2=
TEST_CLAVE_REP_2=
TEST_CUIT_REPRESENTADO_2=
TEST_DENOMINACION_2=

# Credenciales set 3 (para Mis Facilidades)
TEST_CUIT_REP_3=
TEST_CLAVE_REP_3=
TEST_CUIT_REPRESENTADO_3=
TEST_DENOMINACION_3=

# Credenciales para Aportes en Línea (usa TEST_CUIT_REP_3 por defecto si no se especifica)
TEST_CUIT_APORTES=
TEST_CLAVE_APORTES=

# Credenciales para Portal IVA (tests/test_portal_iva_descarga.py)
TEST_CUIT_PORTAL_IVA=
TEST_CLAVE_PORTAL_IVA=
TEST_CUIT_REPRESENTADO_PORTAL_IVA=
TEST_DENOMINACION_PORTAL_IVA=
TEST_PERIODO_PORTAL_IVA=

# Mail de header para prueba SRT alicuotas (opcional, si no se define usa MAIL)
SRT_TEST_MAIL=
